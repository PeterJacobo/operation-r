# ============================================
# Operation R - Configuration File
# ============================================

# --------------------------------------------
# PRINTER CONFIGURATION
# --------------------------------------------
# Choose connection type: 'usb' or 'network'
# Run 'python main.py setup' for interactive configuration
PRINTER_CONNECTION_TYPE=usb

# USB Printer Settings (when PRINTER_CONNECTION_TYPE=usb)
# Default values are for Rongta RP332 thermal printer
# Find your USB IDs: Windows (Get-PnpDevice -Class USB) or Linux/Mac (lsusb)
USB_VENDOR_ID=0x0FE6
USB_PRODUCT_ID=0x811E

# Network Printer Settings (when PRINTER_CONNECTION_TYPE=network)
# Use your printer's IP address and port (usually 9100 for thermal printers)
# Find IP: Check printer network settings or router's connected devices
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# --------------------------------------------
# EMAIL CONFIGURATION
# --------------------------------------------
# Gmail credentials for email monitoring
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password

# --------------------------------------------
# JIRA/ATLASSIAN CONFIGURATION
# --------------------------------------------
# For Jira ticket printing features
JIRA_API_TOKEN=your_jira_token

# Atlassian Cloud ID
# Get from: https://admin.atlassian.com/
# Or run: python main.py get-cloud-id (when MCP is active)
ATLASSIAN_CLOUD_ID=your-cloud-id-here

# --------------------------------------------
# NGROK CONFIGURATION (Optional)
# --------------------------------------------
# For exposing local server to internet (webhooks)
NGROK_AUTHTOKEN=your_ngrok_token
